  "description": "Twitch sprite overlay dashboard and desktop app",
  "author": "SuperFurias",
  "license": "Apache-2.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "desktop:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1",
    "test": "node --test test/phase1.test.js test/physics.test.js test/storage.test.js test/password.test.js test/http.test.js test/websocket.test.js test/accounts.test.js",
    "test:postgres": "node --test --test-concurrency=1 test/postgres.test.js test/postgres-startup.test.js",
    "soak": "node tools/soak.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "body-parser": "^1.20.2",
    "cloudflared": "^0.7.1",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "tmi.js": "^1.9.0-pre.1",
    "ws": "^8.22.0"
  },
  "overrides": {
    "qs": "^6.17.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "cloudflared": true,
    "postinstall-postinstall": true
  }
